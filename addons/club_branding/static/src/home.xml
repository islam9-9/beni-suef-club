<templates xml:space="preserve">
    <t t-name="club_branding.Home">
        <div class="bsc_home" dir="ltr">
            <header class="bsc_home_header">
                <div><span class="bsc_home_eyebrow">BSC · 1928</span><h1>أهلًا بك في نادي بني سويف الرياضي</h1><p>اختر القسم الذي تريد العمل عليه</p></div>
                <img src="/club_branding/static/img/club_logo.png" alt="شعار النادي"/>
            </header>
            <section t-foreach="groups" t-as="group" t-key="group.key" t-attf-class="bsc_home_group bsc_group_{{group.key}}">
                <h2 t-out="group.name"/>
                <div class="bsc_home_apps">
                    <a t-foreach="group.apps" t-as="app" t-key="app.id" t-att-href="app.href" t-on-click.prevent="() => this.open(app)" class="bsc_home_app">
                        <img t-att-src="app.webIconData || '/base/static/description/icon.png'" alt=""/>
                        <span t-out="app.label"/>
                    </a>
                </div>
            </section>
        </div>
    </t>
</templates>
